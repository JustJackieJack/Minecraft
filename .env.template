# Wzór ustawień. Skopiuj do .env (nie trafia na GitHuba) i uzupełnij. Tylko dane, bez tokenów.

# Proxmox-02 i Proxmox-03: ./aktualizuj.sh wgrywa cały plik jako /etc/mc-panel/mc.env
MC_CT=100
MC_ADRES_CT=192.0.2.10
MC_ID_SERWERA=00000000-0000-0000-0000-000000000000

# Nocna przerwa: strona nie włącza serwera, a działający gaśnie, chyba że gra NOC_WYJATEK (nick).
# NOC_OD i NOC_DO są jawne i mogą być takie same jak tutaj.
NOC_OD=23:30
NOC_DO=06:00
NOC_WYJATEK=Gracz

# CT renderu mapy na Proxmox-03 (bez sieci, sam się wyłącza po renderze)
MAPA_CT=102

# Strona: w CT te linie idą do /etc/mc-strona/strona.env
STRONA_ADRES_GRY=mc.example.org

# Mapa: używane tylko przez skrypty na Twoim komputerze
MC_CT_STRONA=101
MAPA_INSTANCJA=/sciezka/do/PrismLauncher/instances/Nazwa/minecraft
MAPA_SWIAT=Nazwa_swiata
